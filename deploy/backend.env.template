# Backend production env for roozgarcab.com. deploy.sh copies this to
# /opt/roozgarcab/app/Backend/.env (mode 600, owned by the roozgarcab user),
# fills JWT_SECRET with a random value, and then stops so you can fill the
# placeholder values. Never commit the filled-in file.

NODE_ENV=production
# PORT is set per instance by Backend/ecosystem.config.cjs; leave it out here.
# HOST defaults to 127.0.0.1 in server.js — nginx is the only thing that should
# reach the Node processes.

# MongoDB. Use a database name of its own so nothing else on the server (or in
# the cluster) shares data with this app. Atlas or a Mongo that already runs on
# this server both work; deploy.sh never installs or touches Mongo.
MONGODB_URI=CHANGE_ME
MONGODB_DB_NAME=roozgarcab_taxi

# Filled by deploy.sh on first run.
JWT_SECRET=__GENERATED__
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://roozgarcab.com,https://www.roozgarcab.com
FRONTEND_URL=https://roozgarcab.com
PUBLIC_FRONTEND_URL=https://roozgarcab.com
PUBLIC_BACKEND_URL=https://roozgarcab.com
PHONEPE_REDIRECT_BASE_URL=https://roozgarcab.com
APP_NAME=Roozgar Cab

# Redis is optional. Without it rate limiting is per process (four instances
# means four times the limit). Use a Redis that is dedicated to this app, or a
# key prefix / separate DB index if you share one.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379/5

# Never enable this in production: it makes every OTP static.
USE_DEFAULT_OTP=false
OTP_EXPIRY_MINUTES=10

# SMS (SMS India Hub)
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_TEXT=

# Optional integrations. Each stays off until it is configured.
GOOGLE_MAPS_API_KEY=
# FIREBASE_DATABASE_URL=
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/roozgarcab/secrets/firebase-service-account.json
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
# Razorpay / PhonePe / Cloudinary keys are stored through the admin panel
# (Settings -> Third-party), not in this file.

# Uploaded images are written here and served by nginx at /uploads/ (alias in
# the site config). Keep both in sync; deploy.sh creates the folder.
UPLOAD_DIR=/var/www/roozgarcab-uploads
UPLOAD_FOLDER=roozgarcab
