# Copy to frontend/.env.production on the deploy target. Vite compiles every
# VITE_* value into the browser bundle, so only ever put public values here.

VITE_API_BASE_URL=https://zicab.in/api/v1
VITE_BACKEND_ORIGIN=https://zicab.in
VITE_SOCKET_URL=https://zicab.in

# Firebase web push. All of these are public by design — the web SDK config ships
# in every client and is protected by Firebase security rules and the authorised
# domains list, not by secrecy.
#
# VITE_FIREBASE_VAPID_KEY is the *public* half of the Web Push key pair
# (Firebase Console -> Project settings -> Cloud Messaging -> Web Push
# certificates). The private half is never used by the client; do not put it in
# any VITE_* variable.
#
# Without all seven of these, registerBrowserFcmToken() returns
# reason: 'firebase-web-config-missing' and web push silently does nothing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Google Maps browser key, used by the admin panel maps (geo-fencing, zone
# creation, driver tracking, dashboard) via
# src/modules/admin/utils/googleMaps.js. Read at build time — unset, the map
# areas render a "Set VITE_GOOGLE_MAPS_API_KEY" placeholder instead.
#
# This ships in the bundle, so restrict it by HTTP referrer in Google Cloud
# Console. The project also needs BILLING ENABLED and the Maps JavaScript API
# turned on, or maps render greyed out with "For development purposes only"
# watermarks and a "This page can't load Google Maps correctly" dialog.
VITE_GOOGLE_MAPS_API_KEY=
