# Copy to Backend/.env and fill in. Only MONGODB_URI and JWT_SECRET are required
# to boot — everything else has a default or degrades gracefully.

NODE_ENV=development
# The frontend defaults its API base to http://localhost:5000/api/v1, so keep
# this at 5000 unless you also set VITE_API_BASE_URL for the frontend.
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=roozgarcab_taxi

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5180,http://localhost:5190
FRONTEND_URL=http://localhost:5190
APP_NAME=Roozgar Cab

# Optional. When disabled the server falls back to in-memory rate limiting.
REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379

# Optional integrations — features that use them stay off until configured.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=

# --- SMSIndiaHub OTP ---
# USE_DEFAULT_OTP is the one switch for the OTP mode:
#   false -> real SMS through SMSIndiaHub (needs the key, sender and template below)
#   true  -> no SMS; everyone logs in with STATIC_OTP_CODE
# Numbers in DEMO_LOGIN_PHONES always log in with their fixed OTP, in either mode.
USE_DEFAULT_OTP=false
# STATIC_OTP_CODE=1234
# DEMO_LOGIN_PHONES=1111111111:1234,2222222222:1234
# SMS_INDIA_HUB_API_KEY=
# SMS_INDIA_HUB_SENDER_ID=BGADEC
# SMS_INDIA_HUB_DLT_TEMPLATE_ID=1007282516644508833
# The DLT-approved text byte for byte (optional: the code already defaults to it).
# Quote it: an unquoted # starts a comment in .env files.
# SMS_INDIA_HUB_DLT_TEMPLATE_TEXT="Welcome to the ##var## powered by Appzeto.Your OTP for registration is ##var##.BGADEC"
# OTP_EXPIRY_MINUTES=10

GOOGLE_MAPS_API_KEY=
