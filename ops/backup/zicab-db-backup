#!/usr/bin/env bash
# Nightly backup of every ZI CAB database on this server.
#
# Writes one compressed archive per run to $BACKUP_DIR, checks it can be read
# back, and keeps the most recent $KEEP. Exits non-zero on any failure, so the
# status file and the cron log show a broken night instead of a silent gap.
#
# The connection string never appears on a command line (where any user could
# read it with `ps`): it is written to a root-only config file for the length
# of the run and removed afterwards.
#
# Restore one archive:
#   mongorestore --uri "$MONGODB_URI" --gzip --archive=<file> --drop
# (see /usr/local/bin/zicab-db-restore-test for a safe, side-by-side restore)
set -euo pipefail

ENV_FILE=/root/zicab/Backend/.env
BACKUP_DIR=/var/backups/zicab-mongo
KEEP=14
STATUS_FILE=$BACKUP_DIR/LAST_RUN

umask 077
mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

stamp=$(date -u +%Y%m%d-%H%M%S)
target="$BACKUP_DIR/zicab-mongo-$stamp.archive.gz"
partial="$target.partial"
config=$(mktemp /root/.zicab-mongodump.XXXXXX.yaml)

fail() {
  echo "$(date -u +%FT%TZ) FAILED: $1" | tee "$STATUS_FILE" >&2
  rm -f "$partial" "$config"
  exit 1
}
trap 'fail "unexpected error on line $LINENO"' ERR

uri=$(grep -E '^MONGODB_URI=' "$ENV_FILE" | head -1 | cut -d= -f2- | tr -d '\r' | sed -e 's/^"//' -e 's/"$//')
[ -n "$uri" ] || fail "MONGODB_URI not found in $ENV_FILE"

printf 'uri: "%s"\n' "$uri" > "$config"

# Dump to a .partial name first, so a run killed half-way never leaves a file
# that looks like a complete backup.
# Every database (mongodump skips `local` itself): production plus the two
# older copies, zicab_live and zicab_taxi - a few MB each, cheaper to keep than
# to decide about. --oplog makes the archive one consistent moment across all
# of them, instead of collection by collection while rides keep being written;
# it needs the replica set this server runs.
mongodump --config="$config" --oplog --gzip --archive="$partial" --quiet \
  || fail "mongodump exited with an error"

# Read the whole archive back without writing anything: catches a truncated
# or corrupt file now, rather than on the day it is needed.
mongorestore --config="$config" --gzip --archive="$partial" --dryRun --quiet \
  || fail "the archive did not read back cleanly"

rm -f "$config"
mv "$partial" "$target"

# Keep the newest $KEEP archives.
ls -1t "$BACKUP_DIR"/zicab-mongo-*.archive.gz 2>/dev/null | tail -n +$((KEEP + 1)) | xargs -r rm -f

size=$(du -h "$target" | cut -f1)
count=$(ls -1 "$BACKUP_DIR"/zicab-mongo-*.archive.gz | wc -l)
echo "$(date -u +%FT%TZ) OK $target ($size, $count kept)" | tee "$STATUS_FILE"
