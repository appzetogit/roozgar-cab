# Installed at /etc/cron.d/roozgarcab-db-backup. Times are UTC (the server clock):
# 21:00 UTC is 02:30 IST, the quietest hour for rides.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Every night: dump all databases, verify, keep the newest 14.
0 21 * * * root /usr/local/bin/roozgarcab-db-backup >> /var/log/roozgarcab-db-backup.log 2>&1

# Every Sunday, an hour later: restore the newest backup into a throwaway
# database and compare it with production, so a broken backup is found
# within a week rather than on the day it is needed.
0 22 * * 0 root /usr/local/bin/roozgarcab-db-restore-test >> /var/log/roozgarcab-db-backup.log 2>&1
